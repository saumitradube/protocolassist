{
  "name": "protocolassist",
  "version": "1.0.0",
  "description": "Clinical Protocol Assistant - Full Stack Application",
  "scripts": {
    "install:frontend": "cd frontend && npm install --legacy-peer-deps",
    "install:all": "npm run install:frontend",
    "build:frontend": "cd frontend && npm run build",
    "deploy:frontend": "cd frontend && npm run deploy",
    "deploy:all": "npm run build:frontend && npm run deploy:frontend",
    "dev:frontend": "cd frontend && npm start",
    "dev:backend": "cd backend && uvicorn app.main:app --reload",
    "start": "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8000"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

